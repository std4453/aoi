    "@fastify/swagger": "^9.4.2",
    "@tus/file-store": "^1.2.0",
    "@tus/server": "^1.2.1",
    "archiver": "8.0.0",
    "better-sqlite3": "13.0.1",
    "blurhash": "^2.0.5",
    "check-disk-space": "3.4.0",
    "fastify": "^5.2.1",
    "iconv-lite": "^0.7.2",
    "p-limit": "^6.2.0",
    "pino-pretty": "^13.1.3",
